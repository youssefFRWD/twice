# Copy this file to .env.local and fill in the values from
# Supabase dashboard -> Project Settings -> API (or "Connect").
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Stripe (Developers -> API keys). Use the test-mode publishable key ("pk_test_...") until you go live.
# The secret key never goes here: it is a Supabase secret used by the Edge Functions in supabase/functions.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
